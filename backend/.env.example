# Copy to .env and fill in values. Never commit .env.

# Dev default is SQLite; use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/skillbridge
DATABASE_URL=sqlite:///skillbridge.db

SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Alibaba Cloud Qwen (DashScope-compatible endpoint)
ALIBABA_CLOUD_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Set to "false" once ALIBABA_CLOUD_API_KEY is configured
AI_MOCK=true

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

RATELIMIT_DEFAULT=200/hour
